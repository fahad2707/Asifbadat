{
  "name": "express-distributors-backend",
  "version": "1.0.0",
  "description": "Backend API for Express Distributors",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "node run-tsc.cjs",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "clear-admin-data": "tsx src/db/clear-admin-data.ts",
    "db:reset": "tsx src/db/clear-all-data.ts",
    "db:clear-products-categories": "tsx src/db/clear-products-categories.ts",
    "db:import-category-xls": "tsx src/db/import-batch-xls.ts",
    "db:import-all-category-xls": "tsx src/db/import-all-category-xls.ts",
    "assign-categories-csv": "tsx src/db/assignCategoriesFromFinalCsv.ts",
    "db:backfill-product-codes": "tsx src/db/backfill-product-codes.ts",
    "db:apply-sku-excel": "tsx src/db/apply-sku-barcode-from-excel.ts",
    "test:document-type": "tsx --test src/utils/documentType.test.ts",
    "test:payment-application": "tsx --test src/services/paymentApplication.test.ts",
    "test:receipt-lifecycle": "tsx --test src/services/receiptLifecycle.test.ts",
    "test:invoice-financial-state": "tsx --test src/utils/invoiceFinancialState.test.ts",
    "test:invoice-list-filter": "tsx --test src/utils/invoiceListFilter.test.ts",
    "test:invoice-route-harness": "tsx --test src/routes/invoiceRouteHarness.test.ts",
    "test:invoice-edit-financial": "tsx --test src/utils/invoiceEditFinancial.test.ts src/routes/invoiceEditFinancial.test.ts",
    "test:customer-balances": "tsx --test src/routes/customerBalances.test.ts",
    "test:online-order-delivery": "tsx --test src/routes/onlineOrderDelivery.test.ts",
    "test:pos-model-a": "tsx --test src/utils/posTender.test.ts src/utils/dashboardFinancial.test.ts src/routes/posSaleTender.test.ts src/routes/posSaleAtomicity.test.ts src/utils/documentType.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.490.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.14.0",
    "stripe": "^14.7.0",
    "twilio": "^4.19.0",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4",
    "typescript": "5.6.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^6.4.14",
    "@types/pdfkit": "^0.12.12",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "supertest": "^7.0.0",
    "tsx": "^4.7.0"
  }
}
