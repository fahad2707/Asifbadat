@@
+import React, { useState } from 'react';
+import toast from 'react-hot-toast';
+import { downloadPdf } from '@/lib/download-pdf';
+import { exportCsv } from '@/lib/export-csv';
+
+type Props = {
+  onClose: () => void;
+};
+
+export default function StatementModal({ onClose }: Props) {
+  const [range, setRange] = useState({ from: '', to: '' });
+  const [account, setAccount] = useState('');
+  const [mode, setMode] = useState('');
+
+  const generate = async (format: 'pdf' | 'csv') => {
+    try {
+      const res = await fetch('/api/bank-statement', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ ...range, account, mode }),
+      });
+      const blob = await res.blob();
+      if (format === 'pdf') downloadPdf(blob, 'BankStatement.pdf');
+      else exportCsv(blob, 'BankStatement.csv');
+    } catch (e) {
+      toast.error('Failed to generate statement');
+    }
+  };
+
+  return (
+    <div className="fixed inset-0 flex items-center justify-center bg-black/30">
+      <div className="bg-white rounded p-6 w-96">
+        <h2 className="text-lg font-semibold mb-4">Bank Statement</h2>
+        <div className="space-y-2">
+          <input
+            type="date"
+            placeholder="From"
+            value={range.from}
+            onChange={(e) => setRange((r) => ({ ...r, from: e.target.value }))}
+            className="w-full border rounded p-2"
+          />
+          <input
+            type="date"
+            placeholder="To"
+            value={range.to}
+            onChange={(e) => setRange((r) => ({ ...r, to: e.target.value }))}
+            className="w-full border rounded p-2"
+          />
+          <input
+            type="text"
+            placeholder="Account"
+            value={account}
+            onChange={(e) => setAccount(e.target.value)}
+            className="w-full border rounded p-2"
+          />
+          <input
+            type="text"
+            placeholder="Mode (cash, cheque, …)"
+            value={mode}
+            onChange={(e) => setMode(e.target.value)}
+            className="w-full border rounded p-2"
+          />
+        </div>
+        <div className="flex justify-end gap-2 mt-4">
+          <button className="px-3 py-1 bg-gray-200 rounded" onClick={onClose}>
+            Close
+          </button>
+          <button className="px-3 py-1 bg-indigo-600 text-white rounded" onClick={() => generate('pdf')}>
+            Print / PDF
+          </button>
+          <button className="px-3 py-1 bg-green-600 text-white rounded" onClick={() => generate('csv')}>
+            Export CSV
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+}
+
