+import React, { useState, useEffect } from 'react';
+import Link from 'next/link';
+import toast from 'react-hot-toast';
+import StatementModal from '@/components/admin/StatementModal';
+
+type Transaction = {
+  id: string;
+  date: string;
+  amount: number;
+  mode: string;
+  account: string;
+  type: 'receive' | 'pay';
+};
+
+export default function BankTransactionPage() {
+  const [type, setType] = useState<'receive' | 'pay'>('receive');
+  const [transactions, setTransactions] = useState<Transaction[]>([]);
+  const [showStatement, setShowStatement] = useState(false);
+
+  const fetchTx = async (t: typeof type) => {
+    const res = await fetch(`/api/bank-transactions?type=${t}`);
+    const data = await res.json();
+    setTransactions(data);
+  };
+
+  useEffect(() => {
+    fetchTx(type);
+  }, [type]);
+
+  return (
+    <div className="space-y-6">
+      <div className="flex gap-4">
+        <button
+          className={`px-4 py-2 rounded ${type === 'receive' ? 'bg-blue-600 text-white' : 'bg-gray-200'}`}
+          onClick={() => setType('receive')}
+        >
+          Received
+        </button>
+        <button
+          className={`px-4 py-2 rounded ${type === 'pay' ? 'bg-blue-600 text-white' : 'bg-gray-200'}`}
+          onClick={() => setType('pay')}
+        >
+          Paid
+        </button>
+        <button className="ml-auto px-4 py-2 bg-indigo-600 text-white rounded" onClick={() => setShowStatement(true)}>
+          Statement
+        </button>
+      </div>
+
+      <table className="w-full text-sm border-collapse">
+        <thead className="bg-gray-50">
+          <tr>
+            <th className="p-2 text-left">Date</th>
+            <th className="p-2 text-left">Account</th>
+            <th className="p-2 text-left">Mode</th>
+            <th className="p-2 text-right">Amount</th>
+          </tr>
+        </thead>
+        <tbody>
+          {transactions.map((tx) => (
+            <tr key={tx.id} className="border-b">
+              <td className="p-2">{new Date(tx.date).toLocaleDateString()}</td>
+              <td className="p-2">{tx.account}</td>
+              <td className="p-2">{tx.mode}</td>
+              <td className="p-2 text-right">{`$${tx.amount.toFixed(2)}`}</td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+
+      {showStatement && <StatementModal onClose={() => setShowStatement(false)} />}
+    </div>
+  );
+}
+
