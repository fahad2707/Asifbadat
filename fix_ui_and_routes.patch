diff --git a/frontend/components/admin/MarkDamageModal.tsx b/frontend/components/admin/MarkDamageModal.tsx
new file mode 100644
index 0000000..e1c2d12
--- /dev/null
+++ b/frontend/components/admin/MarkDamageModal.tsx
@@
+import React, { useState } from 'react';
+import toast from 'react-hot-toast';
+
+type Props = {
+  product: any;
+  onClose: () => void;
+  onSuccess: () => void;
+};
+
+export default function MarkDamageModal({ product, onClose, onSuccess }: Props) {
+  const [qty, setQty] = useState(product.stock_quantity);
+
+  const handleSubmit = async () => {
+    if (qty <= 0 || qty > product.stock_quantity) {
+      toast.error('Invalid quantity');
+      return;
+    }
+    try {
+      await fetch('/api/inventory/mark-damage', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ productId: product.id, quantity: qty }),
+      });
+      toast.success('Marked as damaged');
+      onSuccess();
+    } catch (e) {
+      toast.error('Failed to mark damage');
+    }
+  };
+
+  return (
+    <div className="fixed inset-0 flex items-center justify-center bg-black/30">
+      <div className="bg-white p-6 rounded shadow-lg w-96">
+        <h2 className="text-lg font-semibold mb-4">Mark {product.name} as Damage</h2>
+        <input
+          type="number"
+          min={1}
+          max={product.stock_quantity}
+          value={qty}
+          onChange={(e) => setQty(Number(e.target.value))}
+          className="w-full border rounded p-2 mb-4"
+        />
+        <div className="flex justify-end gap-2">
+          <button className="px-4 py-2 bg-gray-200 rounded" onClick={onClose}>
+            Cancel
+          </button>
+          <button className="px-4 py-2 bg-blue-600 text-white rounded" onClick={handleSubmit}>
+            Apply
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+}
+
